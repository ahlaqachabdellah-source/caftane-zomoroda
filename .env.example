# ---------------------------------------------------------------------------
# Moroccan Caftan Rental — environment variables
# Copy this file to .env.local and fill in the real values.
#
# Where to find them: Supabase Dashboard -> Project Settings -> API
#   VITE_SUPABASE_URL       = Project URL
#   VITE_SUPABASE_ANON_KEY  = "anon" "public" key  (NOT the service_role key)
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public origin of the deployed site (Phase 15 SEO: canonical URLs,
# hreflang, Open Graph, sitemap). No trailing slash.
VITE_SITE_URL=https://YOUR-DOMAIN.example

# ---------------------------------------------------------------------------
# Phase 17 — error monitoring (optional; app runs fine without it)
# Sentry project DSN from https://sentry.io — set ONLY in the hosting
# provider's environment settings, never commit the real value.
# ---------------------------------------------------------------------------
VITE_SENTRY_DSN=
VITE_APP_ENV=production
VITE_APP_VERSION=
